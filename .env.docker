# =============================================================================
# Simplify — Local Docker Environment
# These values point to the docker-compose services instead of cloud.
# Copy relevant values to .env.local when developing against local infra.
# =============================================================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local Supabase (direct Postgres — no Supabase API layer)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-local-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-local-supabase-service-role-key>

# Direct Postgres connection (for scripts, migrations)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/simplify

# OpenRouter (use your real key)
OPENAI_API_KEY=<your-openrouter-api-key>
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Local n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook/simplify-analysis

# Local MinIO (replaces Vercel Blob)
BLOB_READ_WRITE_TOKEN=<your-minio-token>
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=simplify-documents
